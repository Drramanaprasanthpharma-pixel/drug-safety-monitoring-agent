# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI-assisted drug retrieval (backend/app/agent/). Optional — the app works
# fully offline (curated dataset + deterministic safety engine only) without
# these set. When set, a medication not in the curated dataset or alias
# table is looked up via the configured provider, validated, and cached;
# it is never used to override or invent interactions, doses, or thresholds.
#   AI_PROVIDER: "anthropic" (default) or "openai"
#   AI_API_KEY:  API key for that provider — never hard-code this
#   AI_MODEL:    defaults to a current model for the chosen provider if unset
AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=

# Optional — if set, AI-retrieved drugs are cached in this Postgres database
# (see db/schema.sql's drug_search_cache table) instead of a local JSON file.
# Requires `pip install "psycopg[binary]"` (not installed by default).
# DATABASE_URL=

# Reserved for a future production deployment connecting to a licensed
# drug/interaction database instead of the curated demo dataset.
# DRUG_DB_PROVIDER=
# DRUG_DB_API_KEY=

ENVIRONMENT=development
