# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Reserved for a future production deployment — NOT used by the current
# demo rules engine, which never calls an external LLM to generate
# clinical facts. If you extend this project to add narrative summaries
# on top of the structured output, wire it here.
# ANTHROPIC_API_KEY=

# Reserved for a future production deployment connecting to a licensed
# drug/interaction database instead of the curated demo dataset.
# DRUG_DB_PROVIDER=
# DRUG_DB_API_KEY=

ENVIRONMENT=development
